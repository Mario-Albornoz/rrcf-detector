# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=rrcf-detector-consumer
KAFKA_INPUT_TOPIC=normalized-vectors
KAFKA_OUTPUT_TOPIC=anomaly-scores

# Consumer settings
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true
KAFKA_AUTO_COMMIT_INTERVAL_MS=5000
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_RECORDS=500
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Producer settings (optimized for batching)
KAFKA_PRODUCER_CLIENT_ID=rrcf-detector-producer
KAFKA_LINGER_MS=10
KAFKA_BATCH_SIZE=65536
KAFKA_BATCH_NUM_MESSAGES=1000
KAFKA_COMPRESSION_TYPE=lz4
KAFKA_ACKS=1
KAFKA_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=100
KAFKA_QUEUE_BUFFERING_MAX_MESSAGES=100000
KAFKA_QUEUE_BUFFERING_MAX_KBYTES=1048576

# Service Configuration
NUM_WORKERS=4
RRCF_WINDOW_SIZE=1000
MIN_FILL_THRESHOLD=50
